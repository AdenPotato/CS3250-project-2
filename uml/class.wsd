@startuml class

enum Role {
    STUDENT
    VENDOR
}

class User {
    id : int
    name : str
    email : str <<unique>>
    password_hash : str
    role : Role
    active : bool
    creation_date : datetime
    --
    set_password(password)
    check_password(password) : bool
    is_vendor : bool
    is_student : bool
}

class Listing {
    id : int
    vendor_id : int <<FK users>>
    title : str
    description : str
    portions : int <<1..100>>
    portions_remaining : int <<0..portions>>
    location : str <<one of CAMPUS_LOCATIONS>>
    pickup_start : datetime
    pickup_end : datetime <<after pickup_start>>
    cancelled : bool
    creation_date : datetime
}

class DietaryTag {
    id : int
    name : str <<unique>>
}

note right of DietaryTag
  fixed set, created on startup:
  vegetarian, vegan, gluten-free,
  halal, contains nuts
end note

enum ReservationStatus {
    ACTIVE
    PICKED_UP
    CANCELLED
    NO_SHOW
}

class Reservation {
    id : int
    user_id : int <<FK users>>
    listing_id : int <<FK listings>>
    portions : int
    pickup_code : str <<unique 6-char>>
    status : ReservationStatus
    created_at : datetime
    updated_at : datetime
    --
    generate_pickup_code() : str
}

User --> Role
User "1" -- "0..*" Listing : posts >
Listing "0..*" -- "0..*" DietaryTag : tagged with >\n(listing_tags)
User "1" -- "0..*" Reservation : makes >
Listing "1" -- "0..*" Reservation : has >
Reservation --> ReservationStatus

@enduml
