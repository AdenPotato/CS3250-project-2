{
  "permissions": {
    "allow": [
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(pip install -r requirements.txt)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(**/.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Bash(git push --force)",
      "Bash(git push --force:*)",
      "Bash(git push -f)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push origin main:*)"
    ],
    "ask": [
      "Bash(gh issue create:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(git checkout -b:*)",
      "Bash(git switch -c:*)",
      "Bash(git merge:*)",
      "Bash(git tag:*)",
      "Bash(docker build:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose down:*)"
    ]
  }
}
