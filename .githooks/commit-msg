#!/bin/sh
# rejects a commit whose subject is not "CS-<issue number> <message>"
# turn on once per clone: git config core.hooksPath .githooks
subject=$(grep -v '^#' "$1" | head -n 1)
case "$subject" in Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;; esac
if ! printf '%s\n' "$subject" | grep -Eq '^CS-[0-9]+ [^ ]'; then
    echo "commit-msg: subject must look like 'CS-12 add reservation model'" >&2
    echo "commit-msg: got: $subject" >&2
    exit 1
fi
